#!/usr/bin/env python3
"""gjc-env-mirror — base agent .env 를 계정별 agent/.env 실파일로 전파한다.

왜 필요한가 (실측 2026-08-23):

  gjc-acct 의 mirror_trusted_files() 는 **세션 시작 시 한 번만** base 의
  ~/.gjc/agent/.env 를 계정 디렉터리로 복사한다. 그런데 claude-gjc-sync ·
  codex-acct gjc-refresh 타이머는 base .env 만 갱신한다. Anthropic 은 refresh 시
  이전 access token 을 즉시 폐기하므로, 오래 살아 있는 세션은 시작 시점에 굳어버린
  자기 계정 .env 를 계속 읽다가

      401 {"type":"error","error":{"type":"authentication_error",
           "message":"OAuth access token has been revoked."}}

  로 죽는다. gjc 0.15.0 의 $rotatingCredentialEnv() 는 매 호출마다 agent .env 를
  다시 읽으므로(#4737), 그 파일만 제때 갱신되면 살아 있는 세션이 스스로 회복한다.
  이 스크립트가 그 갱신을 담당한다.

  심링크는 쓰지 않는다 — utils/env.ts 의 readTrustedAgentEnv() 가 lstat().isFile()
  + O_NOFOLLOW 로 열기 때문에 심링크면 status=unavailable 이 되고 apiKeyEnv
  프로바이더가 통째로 사라진다(gjc-acct 주석의 2026-08-21 실측).

usage: gjc-env-mirror [--dry-run] [--all]

  기본은 이미 .env 를 가진 계정 디렉터리만 갱신한다(= 한 번이라도 gjc-acct 로
  띄운 계정). --all 은 .env 가 없는 agent 디렉터리에도 새로 만든다.

env:
  GJC_BASE_AGENT_DIR   기본 ~/.gjc/agent
  GJC_ACCOUNTS_DIR     기본 ~/.gjc-accounts
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

BASE_AGENT = Path(os.environ.get("GJC_BASE_AGENT_DIR", Path.home() / ".gjc" / "agent"))
ACCOUNTS = Path(os.environ.get("GJC_ACCOUNTS_DIR", Path.home() / ".gjc-accounts"))


def targets(create_missing: bool) -> list[Path]:
    if not ACCOUNTS.is_dir():
        return []
    out: list[Path] = []
    for slot in sorted(ACCOUNTS.iterdir()):
        agent = slot / "agent"
        if not agent.is_dir():
            continue
        dst = agent / ".env"
        if dst.is_symlink() or dst.is_file() or create_missing:
            out.append(dst)
    return out


def mirror(src_bytes: bytes, dst: Path, dry_run: bool) -> bool:
    """dst 를 src 내용으로 원자적으로 맞춘다. 바뀌었으면 True."""
    if dst.is_symlink():
        if dry_run:
            return True
        dst.unlink()
    elif dst.is_file():
        try:
            if dst.read_bytes() == src_bytes:
                return False
        except OSError:
            pass
    if dry_run:
        return True
    tmp = dst.with_name(f".env.mirror.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(src_bytes)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, dst)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    return True


def main() -> int:
    argv = sys.argv[1:]
    dry_run = "--dry-run" in argv
    create_missing = "--all" in argv

    src = BASE_AGENT / ".env"
    if not src.is_file():
        print(f"FAIL base .env 없음: {src}", file=sys.stderr)
        return 1
    src_bytes = src.read_bytes()

    changed = 0
    failed = 0
    for dst in targets(create_missing):
        try:
            if mirror(src_bytes, dst, dry_run):
                changed += 1
                print(f"{'would update' if dry_run else 'updated'} {dst}")
        except OSError as exc:
            failed += 1
            print(f"FAIL {dst}: {exc}", file=sys.stderr)
    print(f"env 미러링: {changed} 갱신, {failed} 실패 (base {src})")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
